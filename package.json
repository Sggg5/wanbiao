{
  "name": "atelier-time-watch-builder",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:generate": "node scripts/generate-production-assets.mjs",
    "predev": "npm run assets:generate",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "validate:assets": "node scripts/validate-watch-assets.mjs",
    "validate:assets:strict": "node scripts/validate-watch-assets.mjs --strict-webp",
    "prebuild": "npm run validate:assets:strict",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "echarts": "^5.6.0",
    "gsap": "^3.12.5",
    "pinia": "^4.0.3",
    "vite": "^6.0.7",
    "vue": "^3.5.13"
  }
}
