{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wanbiao",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "wanbiao.sggg.cc.cd",
      "custom_domain": true
    }
  ]
}
